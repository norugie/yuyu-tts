# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information). Needed to register slash commands.
DISCORD_CLIENT_ID=
# Optional, for testing: your test server ID (Developer Mode on, right-click the server > Copy Server ID).
# Set: commands register to that server only and update instantly. Empty: commands register
# globally, so they work in every server the bot is invited to (first appearance can take a while).
DISCORD_GUILD_ID=
# Only for running outside Docker (npm start). Inside Docker, compose.yaml sets it to http://kokoro:8880.
KOKORO_URL=http://localhost:8880
# Optional: debug | info | warn | error (default info). debug also logs why a message was not read.
LOG_LEVEL=
